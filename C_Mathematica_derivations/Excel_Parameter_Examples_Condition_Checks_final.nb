"Input",CellLabel -> "In[3]:= ",ExpressionUUID -> "612dba42-e1a7-4664-9508-12d1ecb6bcd8"],Cell[

"\<3. Calculate Michaelis constants and detached-branch inequalities\>","Section",
ExpressionUUID -> "4d138c5a-45a4-415e-8307-22715f29c1af"],Cell[
"\<For each example, compute M1, M3, M5, and M7 from the kinetic rates. Also evaluate both strict inequalities in the detached-branch condition. Passing this condition indicates the detached-branch geometry; it does not by itself determine the complete bifurcation label.\>",
"Text",ExpressionUUID -> "ca48520f-ef4a-4468-a3cd-1040733f6793"],Cell[
CellGroupData[
{Cell[
BoxData[RowBox[{"ToExpression","[","\"derivedExamples = Map[Function[d,Module[{m1,m3,m5,m7,det1,det2},m1=(d[\\\"k11\\\"]+d[\\\"k2\\\"])/d[\\\"k1\\\"];m3=(d[\\\"k33\\\"]+d[\\\"k4\\\"])/d[\\\"k3\\\"];m5=(d[\\\"k55\\\"]+d[\\\"k6\\\"])/d[\\\"k5\\\"];m7=(d[\\\"k77\\\"]+d[\\\"k8\\\"])/d[\\\"k7\\\"];det1=d[\\\"k8\\\"] d[\\\"PTOT\\\"]>d[\\\"k2\\\"] d[\\\"KTOT\\\"];det2=d[\\\"k4\\\"] d[\\\"KTOT\\\"]>d[\\\"k6\\\"] d[\\\"PTOT\\\"];\\nJoin[d,<|\\\"M1\\\"->m1,\\\"M3\\\"->m3,\\\"M5\\\"->m5,\\\"M7\\\"->m7,\\\"DetachedInequality1\\\"->det1,\\\"DetachedInequality2\\\"->det2,\\\"BothDetachedConditions\\\"->(det1&&det2)|>]]],exampleRows];\\nDataset[Map[KeyTake[#, {\\\"Class\\\",\\\"Label\\\",\\\"Iteration\\\",\\\"ExcelRow\\\",\\\"M1\\\",\\\"M3\\\",\\\"M5\\\",\\\"M7\\\",\\\"DetachedInequality1\\\",\\\"DetachedInequality2\\\",\\\"BothDetachedConditions\\\"}]&,derivedExamples]]\"","]"}]],
