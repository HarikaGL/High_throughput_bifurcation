Cell["Added figure. Plots: the symmetric Class 6 set with k5 scaled so that M5/M1 = 1/2, 1 and 2 (first-binding asymmetry). (Top) the diagram near the branch point: a pitchfork for M5 = M1 and transcritical crossings of opposite orientation for M5 < M1 (Class 7) and M5 > M1 (Class 8). (Bottom) the slope s of Eq. (13) as a function of log10(M5/M1) for this set (line), with the slope d ln A_TOT / d ln u at u = 1 computed numerically from the parametrisation (points). Saved as S8_crossing_branch_slope.pdf.", "Text", CellTags -> "AddedPlotCell"],
Cell["(* Plot for Section 8: orientation of the crossing branch, slope s of Eq. (13) *)
Module[{base = figSet6, f = {2., 1., 0.5}, sets, zooms, c0, sEq13, sNum, g},
 sets = Function[fv, Module[{q = base}, q[\"k5\"] = base[\"k5\"] fv; q]] /@ f;
 zooms = MapThread[figDiagram[#1, PlotRange -> {{0.3, 3} #2[\"ATOT\"], {0.03, 30} #2[\"x\"][[2]]},
       PlotLabel -> (\"M5/M1 = \" <> figNum[figConst[#1][\"M5\"]/figConst[#1][\"M1\"], 3] <>
          \",  branch point at A_TOT = \" <> figNum[#2[\"ATOT\"]] <> \" nM\"), ImageSize -> 440] &, {sets, figBP /@ sets}];
 c0 = figConst[base];
 sEq13[lr_] := With[{m1 = c0[\"M1\"], m5 = 10^lr c0[\"M1\"], m3 = c0[\"M3\"], k2 = base[\"k2\"], k4 = base[\"k4\"], kt = base[\"KTOT\"]},
   k4^2 (m5 - m1)/(kt (k4^2 - k2^2) + k4^2 (m1 + m5) + k2 k4 m3)];
 sNum[q_Association] := With[{c = figConst[q], hh = 10^-5},
   (Log[figState[q, c, 1 + hh, 1/(c[\"alpha\"] (1 + hh))][\"ATOT\"]] -
     Log[figState[q, c, 1 - hh, 1/(c[\"alpha\"] (1 - hh))][\"ATOT\"]])/(2 hh)];
 g = Show[Plot[sEq13[lr], {lr, -2, 2}, PlotStyle -> Black],
   ListPlot[{Log10[figConst[#][\"M5\"]/figConst[#][\"M1\"]], sNum[#]} & /@ sets, PlotStyle -> Directive[figRed, PointSize[0.03]]],
   Frame -> True, GridLines -> {{0}, {0}}, FrameLabel -> {\"log10(M5/M1)\", \"slope s = d ln A_TOT / d ln u at u = 1\"},
   PlotLabel -> Column[{\"Eq. (13) (line) and numerical slope (points)\", \"s < 0: Class 7;  s = 0: pitchfork;  s > 0: Class 8\"}, Alignment -> Center],
   ImageSize -> 440];
 figShow[\"S8_crossing_branch_slope\", Append[zooms, g], Column[{GraphicsRow[zooms, ImageSize -> 1100], g}, Center]]]", "Input", CellTags -> "AddedPlotCell"],
