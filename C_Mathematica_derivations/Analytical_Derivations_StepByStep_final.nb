Cell["Added figure. Plots: the coefficients of Section 9 evaluated numerically. (Left) at the detached fold of the Fig 3 set, A_TOT along the exact branch against xi = q.(x - x*) (points) and the normal form A_TOT* + kappa xi^2 with kappa = -aLP/betaLP (dashed). (Middle, right) at the branch point of the symmetric set (pitchfork, a = 0) and of the same set with M5 = 2 M1 (transcritical, a not 0): exact branches near the branch point and the two tangent directions of the branching equation a xi^2 + 2 b xi eta + c eta^2 = 0 (dashed). Saved as S9_normal_forms.pdf.", "Text", CellTags -> "AddedPlotCell"],
Cell["(* Plot for Section 9: fold and branch-point normal-form coefficients, evaluated numerically *)
Module[{pr = figSet3, c = figConst[figSet3], fs, xs, at, jm, q, p, hm, qq, aLP, bLP, kap, pts, gF, gP, gT, trans},
 fs = figDetachedFold[pr]; xs = fs[\"x\"]; at = fs[\"ATOT\"];
 jm = figJac[pr, at, xs]; {q, p} = Most[figNull[jm]];
 hm = figHess[pr, at, xs]; qq = Append[q, 0];
 aLP = (p . (qq . # . qq & /@ hm))/2; bLP = p . figFA[pr, at, xs]; kap = -aLP/bLP;
 pts = Table[With[{s = figState[pr, c, fs[\"u\"] 10^dd, figA[c, fs[\"u\"] 10^dd]]}, {q . (s[\"x\"] - xs), s[\"ATOT\"]}], {dd, -0.05, 0.05, 0.0025}];
 gF = Show[ListPlot[pts, PlotStyle -> Directive[Black, PointSize[0.015]]],
   Plot[at + kap figXi^2, {figXi, Min[pts[[All, 1]]], Max[pts[[All, 1]]]}, PlotStyle -> Directive[figRed, Dashed, Thick]],
   Frame -> True, FrameLabel -> {\"xi = q.(x - x*)\", \"A_TOT (nM)\"}, ImageSize -> 440,
   PlotLabel -> Style[Column[{\"Detached fold of the Fig 3 set\", \"points: exact branch;  dashed: normal form\",
      Row[{\"aLP = \", ScientificForm[aLP, 3], \",  betaLP = \", ScientificForm[bLP, 3], \",  kappa = \", figNum[kap]}]}, Alignment -> Center], 10]];
 gP = figBPPlot[figSet6, \"Symmetric set (Class 6): pitchfork, a = 0\"];
 trans = Module[{qs = figSet6}, qs[\"k5\"] = figSet6[\"k5\"]/2; qs];
 gT = figBPPlot[trans, \"Same set with M5 = 2 M1: transcritical, a not 0\"];
 figShow[\"S9_normal_forms\", {gF, gP, gT}, GraphicsRow[{gF, gP, gT}, ImageSize -> 1300]]]", "Input", CellTags -> "AddedPlotCell"]
},
StyleDefinitions -> "Default.nb",WindowTitle -> "Analytical derivations \[LongDash] step by step",
FrontEndVersion -> "15. for Wolfram Cloud 1.77.1 (August 27, 2026)"]