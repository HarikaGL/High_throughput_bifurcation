Cell["Added figure. Plots for the Fig 3 parameter set: (left) free substrate A(u) on its two positive intervals, with the band r < u < u* where A < 0 (grey); (middle) A_TOT(u): its level set at A_TOT = 23.21 nM gives the three steady states (open circles), its minimum on the detached interval is the fold (black); (right) the complete bifurcation diagram APP against A_TOT obtained by placing every grid point at its A_TOT (blue stable, red unstable). Saved as S5_parametrisation_A_ATOT_diagram.pdf.", "Text", CellTags -> "AddedPlotCell"],
Cell["(* Plot for Section 5: A(u), ATOT(u) and the complete bifurcation diagram *)
Module[{pr = figSet3, c = figConst[figSet3], br, band, g1, g2, g3, roots, fold, curves},
 br = figBranches[pr];
 band = {GrayLevel[0.85], Rectangle[{Log[c[\"r\"]], -100}, {Log[c[\"ustar\"]], 100}]};
 curves = Function[b, {#[\"u\"], #[\"A\"]} & /@ b] /@ br;
 g1 = ListLogLogPlot[curves, Joined -> True, PlotStyle -> Black, Prolog -> band, Frame -> True,
   PlotRange -> {{10^-1, 10^6}, All}, FrameLabel -> {\"u = K/P\", \"free substrate A(u) (nM)\"},
   PlotLabel -> Column[{\"A(u) = (u - r)/(u (alpha u + beta))\", \"r = \" <> figNum[c[\"r\"]] <> \",  u* = \" <> figNum[c[\"ustar\"]] <> \"  (grey: A < 0)\"}, Alignment -> Center],
   ImageSize -> 440];
 roots = {#[\"u\"], #[\"ATOT\"]} & /@ figStatesAt[pr, 23.21];
 fold = With[{f = figDetachedFold[pr]}, {{f[\"u\"], f[\"ATOT\"]}}];
 curves = Function[b, {#[\"u\"], #[\"ATOT\"]} & /@ b] /@ br;
 g2 = ListLogLogPlot[Join[curves, {roots, fold}], Joined -> Join[ConstantArray[True, Length[curves]], {False, False}],
   PlotStyle -> Join[ConstantArray[Black, Length[curves]], {Directive[figRed, PointSize[0.02]], Directive[Black, PointSize[0.025]]}],
   Prolog -> band, Frame -> True, PlotRange -> {{10^-1, 10^6}, {1, 10^4}},
   GridLines -> {None, {23.21}}, FrameLabel -> {\"u = K/P\", \"A_TOT(u) (nM)\"},
   PlotLabel -> Column[{\"Steady states at A_TOT = 23.21 nM: u = \" <> StringRiffle[figNum /@ roots[[All, 1]], \", \"],
      \"fold (black): A_TOT = \" <> figNum[fold[[1, 2]]] <> \" nM\"}, Alignment -> Center], ImageSize -> 440];
 g3 = figDiagram[pr, PlotRange -> {{10^-1, 10^3}, {10^-6, 10^3}},
   PlotLabel -> \"Complete diagram (blue stable, red unstable, black folds)\", ImageSize -> 440];
 figShow[\"S5_parametrisation_A_ATOT_diagram\", {g1, g2, g3}, GraphicsRow[{g1, g2, g3}, ImageSize -> 1300]]]", "Input", CellTags -> "AddedPlotCell"],
