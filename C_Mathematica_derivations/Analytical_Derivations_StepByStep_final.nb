Cell["Added figure. Plots at the three steady states a, b, c of the Fig 3 set at A_TOT = 23.21 nM: (left) sign pattern of the compact analytic Jacobian at state c; (middle) log10 of the entry-wise difference between the compact Jacobian and a central finite-difference Jacobian of the reduced model (round-off level); (right) the largest real part of the eigenvalues at a, b and c (b is the unstable middle state). Saved as S4_compact_Jacobian_checks.pdf.", "Text", CellTags -> "AddedPlotCell"],
Cell["(* Plot for Section 4: compact Jacobian against finite differences, and stability of the three states *)
Module[{pr = figSet3, at = 23.21, sts, xs, jm, jfd, hh = 10^-7, g1, g2, g3, mx},
 sts = figStatesAt[pr, at]; xs = sts[[-1]][\"x\"];
 jm = figJac[pr, at, xs];
 jfd = Transpose[Table[(figRHS[pr, at, xs + hh UnitVector[6, j]] - figRHS[pr, at, xs - hh UnitVector[6, j]])/(2 hh), {j, 6}]];
 g1 = MatrixPlot[Sign[jm], ColorFunction -> (Blend[{figRed, White, figBlue}, (# + 1)/2] &), ColorFunctionScaling -> False,
   FrameTicks -> {{Transpose[{Range[6], {\"AP\", \"APP\", \"AK\", \"APK\", \"APPC\", \"APC\"}}], None},
     {Transpose[{Range[6], {\"AP\", \"APP\", \"AK\", \"APK\", \"APPC\", \"APC\"}}], None}},
   PlotLabel -> \"Sign of the Jacobian at state c (red -, blue +)\", ImageSize -> 440];
 g2 = MatrixPlot[Log10[Abs[jm - jfd] + 10^-16], PlotLegends -> Automatic,
   PlotLabel -> \"log10 |compact Jacobian - finite differences|\", ImageSize -> 440];
 mx = Max[Re[Eigenvalues[figJac[pr, at, #[\"x\"]]]]] & /@ sts;
 g3 = BarChart[Sign[mx] Log10[1 + Abs[mx]/10^-8], ChartLabels -> (Column[{#1, \"u = \" <> figNum[#2[\"u\"]]}, Alignment -> Center] & @@@ Transpose[{{\"a\", \"b\", \"c\"}[[;; Length[sts]]], sts}]),
   ChartStyle -> (If[# < 0, figBlue, figRed] & /@ mx), Frame -> True,
   FrameLabel -> {None, \"sign(max Re) log10(1 + |max Re| / 1e-8)\"},
   PlotLabel -> Column[{\"Largest real part of the eigenvalues\", \"at a, b, c (red: unstable)\"}, Alignment -> Center], ImageSize -> 440];
 figShow[\"S4_compact_Jacobian_checks\", {g1, g2, g3}, GraphicsRow[{g1, g2, g3}, ImageSize -> 1300]]]", "Input", CellTags -> "AddedPlotCell"],
