Cell["Added figure. Plots for the Fig 3 parameter set: (left) APP(t) of the reduced six-state model at A_TOT = 23.21 nM from an unphosphorylated start (X0 = 0) and from a doubly phosphorylated start (APP = A_TOT): the two runs end in different stable steady states; (middle) minus the real parts of the eigenvalues of the analytic Jacobian at the two end states (all positive, so both states are stable); (right) a quasi-static dose sweep: A_TOT increased step by step from X0 = 0, and decreased step by step from APP = A_TOT, each step integrated to steady state. The increasing sweep stays on the main branch; the decreasing sweep stays on the detached branch until its fold (A_TOT = 19.49 nM) and then drops. Saved as S3_time_courses_eigenvalues_dose_sweep.pdf.", "Text", CellTags -> "AddedPlotCell"],
Cell["(* Plot for Section 3: dynamics of the reduced model, Jacobian eigenvalues, dose-up and dose-down sweep *)
Module[{pr = figSet3, at = 23.21, vars, run, xEnd, s0, s1, e0, e1, g1, g2, g3, grid, xu, xd, prev,
   upList = {}, downList = {}, fold},
 vars = Table[figY[i][figT], {i, 6}];
 run[x0_List, at1_, tmax_] := First[NDSolve[Join[Thread[D[vars, figT] == figRHS[pr, at1, vars]],
      Thread[(vars /. figT -> 0) == x0]], vars, {figT, 0, tmax}, MaxSteps -> Infinity]];
 xEnd[s_, tmax_] := (vars /. s) /. figT -> tmax;
 s0 = run[ConstantArray[0., 6], at, 10^6]; s1 = run[{0., at, 0., 0., 0., 0.}, at, 10^6];
 g1 = LogLogPlot[Evaluate[{vars[[2]] /. s0, vars[[2]] /. s1}], {figT, 1, 10^6}, PlotRange -> All,
   Frame -> True, PlotStyle -> {figBlue, figRed},
   PlotLegends -> Placed[{\"start unphosphorylated (X0 = 0)\", \"start doubly phosphorylated (APP = A_TOT)\"}, Below],
   FrameLabel -> {\"time (s)\", \"APP (nM)\"}, PlotLabel -> \"Two stable steady states at A_TOT = 23.21 nM\", ImageSize -> 440];
 e0 = Eigenvalues[figJac[pr, at, xEnd[s0, 10^6]]]; e1 = Eigenvalues[figJac[pr, at, xEnd[s1, 10^6]]];
 g2 = ListLogPlot[{-Re[e0], -Re[e1]}, PlotMarkers -> {Automatic, 10}, PlotStyle -> {figBlue, figRed},
   Frame -> True, FrameLabel -> {\"eigenvalue index\", \"-Re(eigenvalue) (1/s)\"},
   PlotLegends -> Placed[{\"low state (from X0 = 0)\", \"high state (from APP = A_TOT)\"}, Below],
   PlotLabel -> \"Analytic Jacobian: all eigenvalues in the left half-plane\", ImageSize -> 440];
 grid = Range[0.5, 60., 1.];
 xu = ConstantArray[0., 6];
 Do[xu = xEnd[run[xu, a, 2 10^5], 2 10^5]; AppendTo[upList, {a, xu[[2]]}], {a, grid}];
 xd = {0., Last[grid], 0., 0., 0., 0.}; prev = Last[grid];
 Do[xd = xd a/prev; prev = a; xd = xEnd[run[xd, a, 2 10^5], 2 10^5]; AppendTo[downList, {a, xd[[2]]}],
  {a, Reverse[grid]}];
 fold = figDetachedFold[pr][\"ATOT\"];
 g3 = ListLogPlot[{upList, downList}, Joined -> True, PlotMarkers -> {Automatic, 7},
   PlotStyle -> {figBlue, figRed}, Frame -> True, GridLines -> {{fold}, None},
   PlotLegends -> Placed[{\"increasing A_TOT, start X0 = 0\", \"decreasing A_TOT, start APP = A_TOT\"}, Below],
   FrameLabel -> {\"A_TOT (nM)\", \"APP at steady state (nM)\"},
   PlotLabel -> Column[{\"Quasi-static dose sweeps\", \"grid line: detached fold, A_TOT = \" <> figNum[fold] <> \" nM\"}, Alignment -> Center],
   ImageSize -> 440];
 figShow[\"S3_time_courses_eigenvalues_dose_sweep\", {g1, g2, g3}, GraphicsRow[{g1, g2, g3}, ImageSize -> 1300]]]", "Input", CellTags -> "AddedPlotCell"],
