Cell["Added figure. Plots: (top) the Fig 3 set with k8 changed so that x = log10(k8 P_TOT/(k2 K_TOT)) = -0.5, 0.3 and its original value 1.28, at fixed y = log10(k4 K_TOT/(k6 P_TOT)) = 3.46; with x < 0 criterion (10) fails and there is no detached branch (Class 1), with x > 0 a detached branch appears (Classes 2 and 5); the last panel shows the three sets in the (x, y) plane. (Bottom) the symmetric Class 6 set with k4 > k2 (branch point at u = 1, A = 1/alpha) and the same set with k4 = k8 = k2/2 (alpha < 0: no branch point). Saved as S7_detached_branch_and_branch_point_conditions.pdf.", "Text", CellTags -> "AddedPlotCell"],
Cell["(* Plot for Section 7: criterion (10) for the detached branch and the branch-point condition k4 > k2 *)
Module[{pr = figSet3, x0, y0, xt, sets, diags, plane, symNo, d6, d6no},
 {x0, y0} = {Log10[pr[\"k8\"] pr[\"PTOT\"]/(pr[\"k2\"] pr[\"KTOT\"])], Log10[pr[\"k4\"] pr[\"KTOT\"]/(pr[\"k6\"] pr[\"PTOT\"])]};
 xt = {-0.5, 0.3, x0};
 sets = Function[xv, Module[{q = pr}, q[\"k8\"] = pr[\"k8\"] 10^(xv - x0); q]] /@ xt;
 diags = MapThread[figDiagram[#1, PlotLabel -> (\"x = \" <> figNum[#2, 3] <> \",  y = \" <> figNum[y0, 3] <>
        If[#2 > 0 && y0 > 0, \":  detached branch\", \":  no detached branch\"]), ImageSize -> 440] &, {sets, xt}];
 plane = Graphics[{RGBColor[1, 0.85, 0.85], Rectangle[{0, 0}, {5, 5}], Black, Line[{{-5, 0}, {5, 0}}],
    Line[{{0, -5}, {0, 5}}], figRed, PointSize[0.03], Point[{#, y0} & /@ xt],
    Black, Text[\"criterion (10) holds\", {2.5, 4.5}]},
   Frame -> True, PlotRange -> {{-5, 5}, {-5, 5}}, AspectRatio -> 1,
   FrameLabel -> {\"x = log10(k8 P_TOT / k2 K_TOT)\", \"y = log10(k4 K_TOT / k6 P_TOT)\"},
   PlotLabel -> \"The three sets in the plane of criterion (10)\", ImageSize -> 440];
 symNo = Module[{q = figSet6}, q[\"k4\"] = figSet6[\"k2\"]/2; q[\"k8\"] = figSet6[\"k2\"]/2; q];
 d6 = figDiagram[figSet6, PlotLabel -> \"Symmetric set, k4 > k2: branch point (black)\", ImageSize -> 440];
 d6no = figDiagram[symNo, PlotLabel -> \"Same set with k4 = k8 = k2/2: no branch point\", ImageSize -> 440];
 figShow[\"S7_detached_branch_and_branch_point_conditions\", Join[diags, {plane, d6, d6no}],
  Column[{GraphicsRow[Append[diags, plane], ImageSize -> 1300], GraphicsRow[{d6, d6no}, ImageSize -> 700]}, Center]]]", "Input", CellTags -> "AddedPlotCell"],
