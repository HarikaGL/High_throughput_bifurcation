{"-","1"}],",",RowBox[{"-","1"}]}],"}"}]}],"}"}],StandardForm],"Output",CellLabel -> "Out[8]= ",
ExpressionUUID -> "3ac0a48d-f4d9-46be-ac01-37251ed01e03"]},Open],ExpressionUUID -> "d64b874d-3c45-456a-8209-32315bdb225b"],
Cell["Added for the figures: set-up for the plot cells of this notebook. Evaluate it before any plot cell below. All names begin with \"fig\", so the derivations above and below are not affected.", "Text", CellTags -> "AddedPlotCell"],
Cell["(* Shared set-up for the plot cells: evaluate this cell once, before any plot cell.
   All names start with \"fig\" so that they do not clash with the symbols of the
   derivation notebooks (k1, A, K, P, u, x, alpha, ... are left untouched).
   Every figure is shown and also exported as PDF to the sub-folder \"plots\"
   next to this notebook (or of the working directory if the notebook is unsaved). *)
figDir = Quiet[Check[FileNameJoin[{NotebookDirectory[], \"plots\"}], $Failed]];
If[! StringQ[figDir], figDir = FileNameJoin[{Directory[], \"plots\"}]];
If[! DirectoryQ[figDir], CreateDirectory[figDir]];
figSave[name_String, g_] := (Export[FileNameJoin[{figDir, name <> \".pdf\"}], g]; g);
(* figShow prints every panel as its own output (at most 460 points wide, so that the notebook
   prints to PDF without scroll panes cutting the figures) and exports the composite figure. *)
figShow[name_String, panels_List, composite_] := (
   Scan[Print, panels];
   Export[FileNameJoin[{figDir, name <> \".pdf\"}], composite];
   Print[Style[\"saved: \" <> FileNameJoin[{figDir, name <> \".pdf\"}], Gray, 9]];);
(* number formatting without padding messages: n significant digits, integers when large *)
figNum[x_?NumericQ, n_Integer: 4] := StringReplace[
   If[Abs[x] >= 10^n, ToString[Round[x]], ToString[NumberForm[N[x], n]]], RegularExpression[\"\\\\.$\"] -> \"\"];
figBlue = RGBColor[0.12, 0.38, 0.70]; figRed = RGBColor[0.84, 0.24, 0.24];

(* Parameter sets (concentrations in nM; k1, k3, k5, k7 in 1/(nM s); others in 1/s).
   figSet3: Iteration 1, row 96 (Class 5), the set of main-text Fig 3.
   figSet6: Iteration 3, row 5990 (Class 6), fully kinase-phosphatase symmetric. *)
figSet3 = <|\"KTOT\" -> 132.77894269306515, \"PTOT\" -> 16.907466299146936, \"k1\" -> 0.0044702559966119946, \"k11\" -> 0.29969965184730146, \"k2\" -> 0.005182024042454119, \"k3\" -> 0.0032253073948188497, \"k33\" -> 0.013085332598310186, \"k4\" -> 0.5054742845571937, \"k5\" -> 1.033160349871648, \"k55\" -> 0.003440804860184932, \"k6\" -> 0.0013736060258734604, \"k7\" -> 1.2751040197990826, \"k77\" -> 0.005733101589961398, \"k8\" -> 0.7733017996964503|>;
figSet6 = <|\"KTOT\" -> 25.68678690797921, \"PTOT\" -> 25.68678690797921, \"k1\" -> 0.05546638186098454, \"k11\" -> 3.709922237775117, \"k2\" -> 0.01505315498170104, \"k3\" -> 2.969551126146651, \"k33\" -> 6.500575890125845, \"k4\" -> 3.951959656644954, \"k5\" -> 0.05546638186098454, \"k55\" -> 3.709922237775117, \"k6\" -> 0.01505315498170104, \"k7\" -> 2.969551126146651, \"k77\" -> 6.500575890125845, \"k8\" -> 3.951959656644954|>;

(* Constants of the inverse parametrisation, Eqs (7)-(9). *)
figConst[pr_Association] := Module[{m1, m3, m5, m7, a1, a2, r, al, be},
  m1 = (pr[\"k11\"] + pr[\"k2\"])/pr[\"k1\"]; m3 = (pr[\"k33\"] + pr[\"k4\"])/pr[\"k3\"];
  m5 = (pr[\"k55\"] + pr[\"k6\"])/pr[\"k5\"]; m7 = (pr[\"k77\"] + pr[\"k8\"])/pr[\"k7\"];
  a1 = pr[\"k2\"] m7/(pr[\"k8\"] m1); a2 = pr[\"k4\"] m5/(pr[\"k6\"] m3);
  r = pr[\"KTOT\"]/pr[\"PTOT\"];
  al = (a1/m3) (r pr[\"k4\"]/pr[\"k6\"] - 1); be = (1/m1) (r pr[\"k2\"]/pr[\"k8\"] - 1);
  <|\"M1\" -> m1, \"M3\" -> m3, \"M5\" -> m5, \"M7\" -> m7, \"a1\" -> a1, \"a2\" -> a2, \"r\" -> r,
    \"alpha\" -> al, \"beta\" -> be, \"ustar\" -> If[al != 0, -be/al, Infinity],
    \"degenerate\" -> (Abs[al r + be] <= 10^-9 (Abs[al] r + Abs[be]))|>];

(* Free substrate A(u), Eq. (8), and the full steady state at (u, A), Eq. (9). *)
figA[c_Association, u_] := (u - c[\"r\"])/(u (c[\"alpha\"] u + c[\"beta\"]));
figState[pr_Association, c_Association, u_, a_] :=
 Module[{kk, pp, x1, x2, x3, x4, x5, x6},
  kk = pr[\"KTOT\"]/(1 + a/c[\"M1\"] + c[\"a1\"] u a/c[\"M3\"]); pp = kk/u;
  x1 = c[\"a1\"] u a; x2 = c[\"a1\"] c[\"a2\"] u^2 a;
  x3 = a kk/c[\"M1\"]; x4 = x1 kk/c[\"M3\"]; x5 = x2 pp/c[\"M5\"]; x6 = x1 pp/c[\"M7\"];
  <|\"u\" -> u, \"A\" -> a, \"K\" -> kk, \"P\" -> pp, \"x\" -> {x1, x2, x3, x4, x5, x6},
    \"ATOT\" -> a + x1 + x2 + x3 + x4 + x5 + x6|>];

(* Reduced six-state model, Eqs (1)-(2); state order {AP, APP, AK, APK, APPC, APC}. *)
figRHS[pr_Association, at_, xs_List] := Module[{v, fA, fK, fP},
  fA = at - Total[xs]; fK = pr[\"KTOT\"] - xs[[3]] - xs[[4]]; fP = pr[\"PTOT\"] - xs[[5]] - xs[[6]];
  v = {pr[\"k1\"] fA fK - pr[\"k11\"] xs[[3]], pr[\"k2\"] xs[[3]],
       pr[\"k3\"] xs[[1]] fK - pr[\"k33\"] xs[[4]], pr[\"k4\"] xs[[4]],
       pr[\"k5\"] xs[[2]] fP - pr[\"k55\"] xs[[5]], pr[\"k6\"] xs[[5]],
       pr[\"k7\"] xs[[1]] fP - pr[\"k77\"] xs[[6]], pr[\"k8\"] xs[[6]]};
  {v[[2]] - v[[3]] + v[[6]] - v[[7]], v[[4]] - v[[5]], v[[1]] - v[[2]],
   v[[3]] - v[[4]], v[[5]] - v[[6]], v[[7]] - v[[8]]}];

(* Analytic Jacobian in the compact form of the notebook (support/jac6.m). *)
figJac[pr_Association, at_, xs_List] := Module[{x1, x2, x3, x4, x5, x6, s, cK, cP},
  {x1, x2, x3, x4, x5, x6} = xs; s = Total[xs] - at;
  cK = x3 + x4 - pr[\"KTOT\"]; cP = x5 + x6 - pr[\"PTOT\"];
  With[{k1 = pr[\"k1\"], k11 = pr[\"k11\"], k2 = pr[\"k2\"], k3 = pr[\"k3\"], k33 = pr[\"k33\"],
        k4 = pr[\"k4\"], k5 = pr[\"k5\"], k55 = pr[\"k55\"], k6 = pr[\"k6\"], k7 = pr[\"k7\"],
        k77 = pr[\"k77\"], k8 = pr[\"k8\"]},
   {{k3 cK + k7 cP, 0, k2 + x1 k3, k33 + x1 k3, k6 + x1 k7, k77 + x1 k7},
    {0, k5 cP, 0, k4, k55 + x2 k5, x2 k5},
    {k1 cK, k1 cK, k1 s - k11 - k2 + k1 cK, k1 s + k1 cK, k1 cK, k1 cK},
    {-k3 cK, 0, -x1 k3, -k4 - k33 - x1 k3, 0, 0},
    {0, -k5 cP, 0, 0, -k6 - k55 - x2 k5, -x2 k5},
    {-k7 cP, 0, 0, 0, -x1 k7, -k8 - k77 - x1 k7}}]];
figStableQ[pr_Association, at_, xs_List] := Max[Re[Eigenvalues[N[figJac[pr, at, xs]]]]] < 0;

(* All positive steady states as branches of the parametrisation. *)
figPosQ[s_Association] := Min[s[\"x\"]] > 0 && s[\"K\"] > 0 && s[\"P\"] > 0;
figUGrid[c_Association] := Module[{crit = Select[{c[\"r\"], c[\"ustar\"]}, 0 < # < Infinity &]},
  Union[10.^Range[-14., 10., 0.004],
   Flatten[Table[cc {1 - 10.^-k, 1 + 10.^-k}, {cc, crit}, {k, 1, 12}]]]];
figBranches[pr_Association] := Module[{c = figConst[pr], r, crit, us, pts, br},
  r = c[\"r\"];
  If[TrueQ[c[\"degenerate\"]],
   (* symmetric case: the line u = r (any A) and the curve A = 1/(alpha u) *)
   br = {figState[pr, c, r, #] & /@ (10.^Range[-8., 8., 0.004])};
   If[c[\"alpha\"] > 0,
    AppendTo[br, figState[pr, c, #, 1/(c[\"alpha\"] #)] & /@ (10.^Range[-6., 6., 0.002])]],
   (* general case: the intervals of {u > 0 : A(u) > 0} between r and u* *)
   crit = Select[{r, c[\"ustar\"]}, 0 < # < Infinity &];
   us = Select[figUGrid[c], figA[c, #] > 0 &];
   pts = figState[pr, c, #, figA[c, #]] & /@ us;
   br = GatherBy[pts, Function[s, Count[crit, cc_ /; cc < s[\"u\"]]]]];
  br = Function[b, Select[b, figPosQ]] /@ br;
  Select[br, Length[#] > 1 &]];

(* Folds: extrema of ATOT along a branch; branch point of the symmetric case. *)
figFoldsOf[branch_List] := Module[{g = #[\"ATOT\"] & /@ branch, d},
  d = Differences[Sign[Differences[g]]];
  branch[[1 + Flatten[Position[d, z_ /; z != 0, {1}]]]]];
figBP[pr_Association] := With[{c = figConst[pr]},
  If[TrueQ[c[\"degenerate\"]] && c[\"alpha\"] > 0,
   figState[pr, c, c[\"r\"], 1/c[\"alpha\"]], Missing[\"NoBranchPoint\"]]];
figSingular[pr_Association, br_List] :=
  Join[Flatten[figFoldsOf /@ br, 1], If[MissingQ[figBP[pr]], {}, {figBP[pr]}]];

(* Exact bifurcation diagram APP against ATOT: blue stable, red unstable, black dots
   folds and branch points. Options (PlotRange, PlotLabel, ...) are passed on. *)
figDiagram[pr_Association, opts___] := Module[{br = figBranches[pr], lab, st, un, sing, data},
  lab = Flatten[Function[b, {#[\"ATOT\"], #[\"x\"][[2]], figStableQ[pr, #[\"ATOT\"], #[\"x\"]]} & /@ b] /@ br, 1];
  st = Cases[lab, {a_, b_, True} :> {a, b}]; un = Cases[lab, {a_, b_, False} :> {a, b}];
  sing = {#[\"ATOT\"], #[\"x\"][[2]]} & /@ figSingular[pr, br];
  data = Select[{{st, Directive[figBlue, PointSize[0.006]]}, {un, Directive[figRed, PointSize[0.006]]},
      {sing, Directive[Black, PointSize[0.02]]}}, Length[First[#]] > 0 &];
  ListLogLogPlot[data[[All, 1]], opts, PlotStyle -> data[[All, 2]],
   PlotRange -> {{10^-1, 10^6}, All}, Frame -> True, FrameLabel -> {\"A_TOT (nM)\", \"APP (nM)\"},
   ImageSize -> 440]];

(* Steady states at a given ATOT (roots of ATOT(u) = at on every branch). *)
figStatesAt[pr_Association, at_] := Module[{c = figConst[pr], br, out = {}, g, lu, s},
  br = figBranches[pr];
  Do[g = #[\"ATOT\"] - at & /@ b;
   Do[If[g[[j]] g[[j + 1]] <= 0,
     AppendTo[out,
      If[TrueQ[c[\"degenerate\"]], b[[j]],
       s = FindRoot[figState[pr, c, 10^lu, figA[c, 10^lu]][\"ATOT\"] == at,
         {lu, Log10[b[[j]][\"u\"]], Log10[b[[j + 1]][\"u\"]]}];
       figState[pr, c, 10^(lu /. s), figA[c, 10^(lu /. s)]]]]],
    {j, Length[g] - 1}], {b, br}];
  SortBy[out, #[\"u\"] &]];

(* Fold of the detached branch (minimum of ATOT(u) on the branch that does not reach u = r). *)
figDetachedFold[pr_Association] := Module[{c = figConst[pr], br, det, i0, lu, sol},
  If[TrueQ[c[\"degenerate\"]], Return[Missing[\"NoDetachedBranch\"]]];
  br = figBranches[pr];
  det = Select[br, Min[Abs[Log10[#[\"u\"]/c[\"r\"]]] & /@ #] > 10^-3 &];
  If[det === {}, Return[Missing[\"NoDetachedBranch\"]]];
  det = First[det];
  i0 = First[Ordering[#[\"ATOT\"] & /@ det, 1]];
  (* derivative-free search started from two points (no line search, no lstol message) *)
  sol = Quiet[FindMinimum[figState[pr, c, 10^lu, figA[c, 10^lu]][\"ATOT\"],
     {lu, Log10[det[[i0]][\"u\"]] - 0.01, Log10[det[[i0]][\"u\"]] + 0.01}], {FindMinimum::lstol}];
  figState[pr, c, 10^(lu /. sol[[2]]), figA[c, 10^(lu /. sol[[2]])]]];

(* Second derivatives and dF/dATOT in augmented coordinates (x1..x6, ATOT), and the
   right/left null vectors q, p of a singular Jacobian (|q| = 1, p.q = 1). *)
figHess[pr_Association, at_, xs_List] := Module[{z = Array[figZ, 7], f},
  f = figRHS[pr, z[[7]], z[[1 ;; 6]]];
  D[f, {z, 2}] /. Thread[z -> Append[xs, at]]];
figFA[pr_Association, at_, xs_List] := Module[{z7}, D[figRHS[pr, z7, xs], z7] /. z7 -> at];
figNull[jm_] := Module[{uu, ww, vv, q, p},
  {uu, ww, vv} = SingularValueDecomposition[N[jm]];
  q = vv[[All, -1]]; p = uu[[All, -1]]; q = q/Norm[q]; p = p/(p . q);
  {q, p, ww[[-1, -1]]/ww[[1, 1]]}];

(* Branch point: exact branches near the branch point in linear axes, with the two
   tangent directions given by the branching equation a xi^2 + 2 b xi eta + c eta^2 = 0. *)
figBPPlot[pr_Association, title_] := Module[{bp, xs, at, app, jm, q, p, fa, mm, sol, v0, h, qb, vb,
   a, b, cc, dirs, lines, br, lab, st, un, tmax},
  bp = figBP[pr]; If[MissingQ[bp], Return[Missing[\"NoBranchPoint\"]]];
  xs = bp[\"x\"]; at = bp[\"ATOT\"]; app = xs[[2]];
  jm = figJac[pr, at, xs]; {q, p} = Most[figNull[jm]]; fa = figFA[pr, at, xs];
  mm = ArrayFlatten[{{jm, Transpose[{p}]}, {{q}, 0}}];
  sol = LinearSolve[mm, Append[-fa, 0]]; v0 = Most[sol];
  h = figHess[pr, at, xs]; qb = Append[q, 0]; vb = Append[v0, 1];
  a = p . (qb . # . qb & /@ h); b = p . (qb . # . vb & /@ h); cc = p . (vb . # . vb & /@ h);
  dirs = If[Abs[a] < 10^-4 Max[Abs[{b, cc}]],
    {{1, 0}, {-cc/(2 b), 1}},
    {{(-b + Sqrt[b^2 - a cc])/a, 1}, {(-b - Sqrt[b^2 - a cc])/a, 1}}];
  lines = Function[d, With[{w = d[[1]] qb + d[[2]] vb}, {w[[7]], w[[2]]}]] /@ dirs;
  br = figBranches[pr];
  lab = Flatten[Function[bb, {#[\"ATOT\"], #[\"x\"][[2]], figStableQ[pr, #[\"ATOT\"], #[\"x\"]]} & /@ bb] /@ br, 1];
  lab = Select[lab, 0.4 at < #[[1]] < 1.6 at && #[[2]] < 3 app &];
  st = Cases[lab, {x_, y_, True} :> {x, y}]; un = Cases[lab, {x_, y_, False} :> {x, y}];
  Show[ListPlot[Select[{st, un}, Length[#] > 0 &],
    PlotStyle -> {Directive[figBlue, PointSize[0.006]], Directive[figRed, PointSize[0.006]]}],
   Graphics[{Black, Dashed, Thickness[0.004],
     Function[l, tmax = Min[If[Abs[l[[1]]] > 0, 0.5 at/Abs[l[[1]]], Infinity],
         If[Abs[l[[2]]] > 0, 1.2 app/Abs[l[[2]]], Infinity]];
       Line[{{at, app} - tmax l, {at, app} + tmax l}]] /@ lines,
     PointSize[0.025], Point[{at, app}]}],
   PlotRange -> {{0.4 at, 1.6 at}, {0, 3 app}}, Frame -> True,
   FrameLabel -> {\"A_TOT (nM)\", \"APP (nM)\"}, ImageSize -> 440,
   PlotLabel -> Style[Column[{title, Row[{\"a = \", ScientificForm[a, 3], \",  b = \", ScientificForm[b, 3],
        \",  c = \", ScientificForm[cc, 3]}], Row[{\"discriminant b^2 - a c = \", ScientificForm[b^2 - a cc, 3],
        \"  (dashed: tangents)\"}]}, Alignment -> Center], 10]]];", "Input", CellTags -> "AddedPlotCell"],
Cell["Added figure. Plot: the reaction network drawn from the complexes and the 12 directed reactions of Section 1 (two linkage classes, kinase above and phosphatase below). Saved as S1_reaction_network.pdf.", "Text", CellTags -> "AddedPlotCell"],
Cell["(* Plot for Section 1: reaction network (10 complexes, 12 reaction directions, 2 linkage classes) *)
figComplexNames = {\"A+K\", \"AK\", \"AP+K\", \"APK\", \"APP+K\", \"APP+P\", \"APPC\", \"AP+P\", \"APC\", \"A+P\"};
figEdges = {{1, 2}, {2, 1}, {2, 3}, {3, 4}, {4, 3}, {4, 5}, {6, 7}, {7, 6}, {7, 8}, {8, 9}, {9, 8}, {9, 10}};
figEdgeLabels = {\"k1\", \"k11\", \"k2\", \"k3\", \"k33\", \"k4\", \"k5\", \"k55\", \"k6\", \"k7\", \"k77\", \"k8\"};
figNetwork = Graph[Range[10],
   MapThread[Labeled[DirectedEdge @@ #1, #2] &, {figEdges, figEdgeLabels}],
   VertexCoordinates -> Join[Table[{2 i, 1}, {i, 0, 4}], Table[{8 - 2 i, 0}, {i, 0, 4}]],
   VertexLabels -> Thread[Range[10] -> (Placed[Style[#, 9, Bold], Center] & /@ figComplexNames)],
   VertexShapeFunction -> \"RoundedRectangle\", VertexSize -> {\"Scaled\", 0.11},
   VertexStyle -> Directive[White, EdgeForm[Gray]], EdgeStyle -> Gray,
   EdgeLabelStyle -> Directive[9, figBlue], ImageSize -> 460,
   PlotLabel -> Style[\"Kinase linkage class (top), phosphatase linkage class (bottom)\", 10]];
figShow[\"S1_reaction_network\", {figNetwork}, figNetwork]", "Input", CellTags -> "AddedPlotCell"],
Cell[

"\<2. Verify conservation laws and deficiency\>","Section",ExpressionUUID -> "422ad072-dbb0-46ef-be72-090902464a5a"],Cell[

"\<The three conserved totals must annihilate every stoichiometric reaction vector. The deficiency is c \[Minus] l \[Minus] rank(N), with ten complexes and two linkage classes.\>",
