Cell["Added figure. Plot: along every branch of the Fig 3 set, the relative residuals of the two site-flux balances (v2 = v8, v4 = v6), of the phosphatase total, and of all six steady-state equations F(x) = 0, evaluated numerically for the reconstructed states. All lie at round-off level, so every grid point of the parametrisation is an exact steady state. Saved as S6_parametrisation_residuals.pdf.", "Text", CellTags -> "AddedPlotCell"],
Cell["(* Plot for Section 6: numerical residuals of the identities along the parametrised branches *)
Module[{pr = figSet3, pts, res, fl = 10^-18},
 pts = Flatten[figBranches[pr], 1];
 res = Function[s, With[{xx = s[\"x\"], pp = s[\"P\"]},
      {s[\"u\"],
       Max[fl, Abs[pr[\"k2\"] xx[[3]] - pr[\"k8\"] xx[[6]]]/(pr[\"k2\"] xx[[3]])],
       Max[fl, Abs[pr[\"k4\"] xx[[4]] - pr[\"k6\"] xx[[5]]]/(pr[\"k4\"] xx[[4]])],
       Max[fl, Abs[pp + xx[[5]] + xx[[6]] - pr[\"PTOT\"]]/pr[\"PTOT\"]],
       Max[fl, Max[Abs[figRHS[pr, s[\"ATOT\"], xx]]]/Max[pr[\"k1\"] s[\"ATOT\"] pr[\"KTOT\"], Max[Abs[xx]]]]}]] /@ pts;
 With[{g = ListLogLogPlot[{res[[All, {1, 2}]], res[[All, {1, 3}]], res[[All, {1, 4}]], res[[All, {1, 5}]]},
   PlotRange -> {All, {10^-18, 10^-6}}, Frame -> True, FrameLabel -> {\"u = K/P\", \"relative residual\"},
   PlotLegends -> Placed[{\"site 1 flux, v2 = v8\", \"site 2 flux, v4 = v6\", \"phosphatase total\", \"all six equations F(x) = 0\"}, Below],
   PlotLabel -> Column[{\"The parametrised states satisfy every\", \"steady-state identity to round-off\"}, Alignment -> Center], ImageSize -> 440]},
  figShow[\"S6_parametrisation_residuals\", {g}, g]]]", "Input", CellTags -> "AddedPlotCell"],
